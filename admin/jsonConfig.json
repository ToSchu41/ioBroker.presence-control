{
  "i18n": true,
  "type": "tabs",
  "items": {
    "general": {
      "type": "panel",
      "label": "Allgemein und Residents",
      "items": {
        "enabled": {"type": "checkbox", "label": "Presence Control aktivieren", "newLine": true},
        "residentsAnyoneHomeId": {"type": "objectId", "label": "Residents: Jemand zuhause", "tooltip": "Boolescher Datenpunkt: true = mindestens eine Person zuhause", "newLine": true},
        "residentsLongAbsentId": {"type": "objectId", "label": "Residents: länger abwesend / Urlaub", "tooltip": "Boolescher Datenpunkt aus residents für längere Abwesenheit", "newLine": true},
        "homeDelaySec": {"type": "number", "label": "Verzögerung Rückkehr (Sekunden)", "min": 0, "max": 3600, "newLine": true},
        "awayDelaySec": {"type": "number", "label": "Verzögerung Abwesenheit (Sekunden)", "min": 0, "max": 86400},
        "unknownAfterMin": {"type": "number", "label": "Quelle ungültig nach (Minuten)", "min": 1, "max": 10080},
        "modeNamesInfo": {"type": "staticText", "text": "Die internen Modi bleiben home, away, vacation und unknown. Die folgenden Bezeichnungen werden für Telegram-Texte und Platzhalter verwendet.", "newLine": true},
        "modeNameHome": {"type": "text", "label": "Anzeigename Home", "newLine": true},
        "modeNameAway": {"type": "text", "label": "Anzeigename Away"},
        "modeNameVacation": {"type": "text", "label": "Anzeigename Vacation", "newLine": true},
        "modeNameUnknown": {"type": "text", "label": "Anzeigename Unknown"}
      }
    },
    "shutter": {
      "type": "panel",
      "label": "Shuttercontrol",
      "items": {
        "shutterInfo": {"type": "staticText", "text": "Presence Control löst nur die hier festgelegten Aktionen beim bestätigten Wechsel eines Gebäudemodus aus. Sturm-, Gewitter-, Frost-, Fenster-, Beschattungs- und Fahrlogik verbleiben vollständig in shuttercontrol.", "newLine": true},
        "shutterEnabled": {"type": "checkbox", "label": "Shuttercontrol integrieren", "newLine": true},
        "shutterInterfaceInfo": {"type": "staticText", "text": "Schnittstellen – für shuttercontrol.0 vorausgewählt und bei Bedarf änderbar.", "newLine": true},
        "shutterHolidayId": {"type": "objectId", "label": "Holiday-Schalter", "newLine": true},
        "shutterAutoAllId": {"type": "objectId", "label": "Alle Rollos auf Automatik"},
        "shutterOpenAllId": {"type": "objectId", "label": "Alle öffnen", "newLine": true},
        "shutterCloseAllId": {"type": "objectId", "label": "Alle schließen"},
        "shutterOpenLivingId": {"type": "objectId", "label": "Wohnbereich öffnen", "newLine": true},
        "shutterCloseLivingId": {"type": "objectId", "label": "Wohnbereich schließen"},
        "shutterOpenChildrenId": {"type": "objectId", "label": "Kinderbereich öffnen", "newLine": true},
        "shutterCloseChildrenId": {"type": "objectId", "label": "Kinderbereich schließen"},
        "shutterOpenSleepId": {"type": "objectId", "label": "Schlafbereich öffnen", "newLine": true},
        "shutterCloseSleepId": {"type": "objectId", "label": "Schlafbereich schließen"},
        "shutterActionsInfo": {"type": "staticText", "text": "Modusaktionen – jede Zeile wird einmal nach dem bestätigten Wechsel zum ausgewählten Modus ausgeführt. Die Verzögerung beginnt erst nach dem Moduswechsel. 'Nur dunkel' prüft den von Presence Control ermittelten Lichtzustand.", "newLine": true},
        "shutterModeActions": {
          "type": "table",
          "label": "Aktionen bei Moduswechsel",
          "newLine": true,
          "items": [
            {"type": "checkbox", "attr": "enabled", "title": "Aktiv", "width": "5%"},
            {"type": "text", "attr": "name", "title": "Beschreibung", "width": "24%"},
            {"type": "select", "attr": "mode", "title": "Ausführen bei Wechsel zu", "options": [{"label": "Home", "value": "home"}, {"label": "Away", "value": "away"}, {"label": "Vacation", "value": "vacation"}, {"label": "Unknown", "value": "unknown"}], "width": "12%"},
            {"type": "select", "attr": "action", "title": "Aktion", "options": [{"label": "Holiday aktivieren", "value": "holidayOn"}, {"label": "Holiday deaktivieren", "value": "holidayOff"}, {"label": "Alle auf Automatik", "value": "autoAll"}, {"label": "Alle öffnen", "value": "openAll"}, {"label": "Alle schließen", "value": "closeAll"}, {"label": "Wohnen öffnen", "value": "openLiving"}, {"label": "Wohnen schließen", "value": "closeLiving"}, {"label": "Kinder öffnen", "value": "openChildren"}, {"label": "Kinder schließen", "value": "closeChildren"}, {"label": "Schlafen öffnen", "value": "openSleep"}, {"label": "Schlafen schließen", "value": "closeSleep"}, {"label": "Eigener Button", "value": "customButton"}], "width": "20%"},
            {"type": "objectId", "attr": "customTargetId", "title": "Eigener Button (nur bei eigener Aktion)", "width": "24%"},
            {"type": "number", "attr": "delaySec", "title": "Verzögerung s", "min": 0, "width": "8%"},
            {"type": "checkbox", "attr": "onlyDark", "title": "Nur dunkel", "width": "7%"}
          ]
        },
        "shutterExampleInfo": {"type": "staticText", "text": "Beispiel: 'Away + Wohnen schließen + 600 s + Nur dunkel' bedeutet: zehn Minuten nach dem bestätigten Wechsel zu Away wird closeLiving ausgelöst, aber nur wenn es dann dunkel ist. Bei Unknown ist standardmäßig keine Fahraktion aktiv.", "newLine": true}
      }
    },
    "light": {
      "type": "panel",
      "label": "Sonnenstand und Helligkeit",
      "items": {
        "sunInfo": {"type": "staticText", "text": "Sonnenstand und Sonnenzeiten werden aus shuttercontrol übernommen. Ein externer Lux-Sensor kann bevorzugt verwendet werden; bei fehlendem Wert dient der Sonnenstand als Ersatz.", "newLine": true},
        "lightSourceMode": {"type": "select", "label": "Auswertung", "options": [{"label": "Helligkeit bevorzugen, Sonnenstand als Ersatz", "value": "brightnessFallbackSun"}, {"label": "Nur Helligkeitssensor", "value": "brightness"}, {"label": "Nur Sonnenstand", "value": "sun"}, {"label": "Beide müssen dunkel melden", "value": "both"}], "newLine": true},
        "brightnessId": {"type": "objectId", "label": "Helligkeitssensor (Lux)", "newLine": true},
        "darkLux": {"type": "number", "label": "Dunkel unter (Lux)", "min": 0, "max": 100000},
        "brightLux": {"type": "number", "label": "Hell über (Lux)", "min": 0, "max": 100000},
        "sunElevationId": {"type": "objectId", "label": "Sonnenhöhe / Elevation", "newLine": true},
        "sunAzimuthId": {"type": "objectId", "label": "Sonnenrichtung / Azimut"},
        "sunriseId": {"type": "objectId", "label": "Sonnenaufgang", "newLine": true},
        "sunsetId": {"type": "objectId", "label": "Sonnenuntergang"},
        "goldenHourId": {"type": "objectId", "label": "Golden Hour", "newLine": true},
        "goldenHourEndId": {"type": "objectId", "label": "Golden Hour Ende"},
        "darkElevation": {"type": "number", "label": "Dunkel unter Sonnenhöhe (°)", "min": -20, "max": 20, "step": 0.5, "newLine": true},
        "brightElevation": {"type": "number", "label": "Hell über Sonnenhöhe (°)", "min": -20, "max": 20, "step": 0.5}
      }
    },
    "actions": {
      "type": "panel",
      "label": "Licht und Verbraucher",
      "items": {
        "actionHelp": {"type": "staticText", "text": "Diese Aktionen werden einmal nach dem bestätigten Wechsel zum ausgewählten Modus ausgeführt. Die zwei deaktivierten Beispielzeilen dienen als Einrichtungshilfe.", "newLine": true},
        "actions": {"type": "table", "label": "Aktionen", "newLine": true, "items": [
          {"type": "checkbox", "attr": "enabled", "title": "Aktiv", "width": "6%"},
          {"type": "text", "attr": "name", "title": "Name", "width": "22%"},
          {"type": "select", "attr": "trigger", "title": "Bei Wechsel zu", "options": [{"label": "Home", "value": "home"}, {"label": "Away", "value": "away"}, {"label": "Vacation", "value": "vacation"}, {"label": "Unknown", "value": "unknown"}], "width": "11%"},
          {"type": "objectId", "attr": "targetId", "title": "Zieldatenpunkt", "width": "25%"},
          {"type": "text", "attr": "value", "title": "Wert", "width": "8%"},
          {"type": "select", "attr": "valueType", "title": "Typ", "options": [{"label": "Boolean", "value": "boolean"}, {"label": "Zahl", "value": "number"}, {"label": "Text", "value": "string"}], "width": "9%"},
          {"type": "checkbox", "attr": "onlyDark", "title": "Nur dunkel", "width": "7%"},
          {"type": "number", "attr": "delaySec", "title": "Verz. s", "width": "6%"},
          {"type": "number", "attr": "offAfterSec", "title": "Aus nach s", "width": "6%"}
        ]}
      }
    },
    "telegram": {
      "type": "panel",
      "label": "Telegram-Benachrichtigungen",
      "items": {
        "telegramInfo": {"type": "staticText", "text": "Bei einem tatsächlichen, bestätigten Moduswechsel kann eine Nachricht über den Telegram-Adapter gesendet werden. Platzhalter: {mode}, {previousMode}, {date}, {time}.", "newLine": true},
        "telegramEnabled": {"type": "checkbox", "label": "Telegram-Benachrichtigungen aktivieren", "newLine": true},
        "telegramInstance": {"type": "text", "label": "Telegram-Instanz", "tooltip": "Zum Beispiel telegram.0", "newLine": true},
        "telegramUser": {"type": "text", "label": "Empfänger/Benutzer (optional)", "tooltip": "Leer lassen, um den Standardempfänger der Telegram-Instanz zu verwenden"},
        "telegramNotifyOnStartup": {"type": "checkbox", "label": "Aktuellen Modus auch beim Adapterstart senden", "newLine": true},
        "telegramNotifyHome": {"type": "checkbox", "label": "Home melden", "newLine": true},
        "telegramTextHome": {"type": "text", "label": "Text für Home", "newLine": true},
        "telegramNotifyAway": {"type": "checkbox", "label": "Away melden", "newLine": true},
        "telegramTextAway": {"type": "text", "label": "Text für Away", "newLine": true},
        "telegramNotifyVacation": {"type": "checkbox", "label": "Vacation melden", "newLine": true},
        "telegramTextVacation": {"type": "text", "label": "Text für Vacation", "newLine": true},
        "telegramNotifyUnknown": {"type": "checkbox", "label": "Unknown melden", "newLine": true},
        "telegramTextUnknown": {"type": "text", "label": "Text für Unknown", "newLine": true}
      }
    },
    "simulation": {
      "type": "panel",
      "label": "Anwesenheitssimulation",
      "items": {
        "simulationEnabled": {"type": "checkbox", "label": "Simulation aktivieren", "newLine": true},
        "simulationOnlyVacation": {"type": "checkbox", "label": "Nur im Urlaubsmodus", "newLine": true},
        "simulationInfo": {"type": "staticText", "text": "Simulationsaktionen werden täglich zufällig innerhalb des Zeitfensters geplant. Shuttercontrol-Buttons können als Trigger verwendet werden; die Sicherheitslogik bleibt in shuttercontrol.", "newLine": true},
        "simulationEntries": {"type": "table", "label": "Simulationsaktionen", "newLine": true, "items": [
          {"type": "checkbox", "attr": "enabled", "title": "Aktiv", "width": "6%"},
          {"type": "text", "attr": "name", "title": "Name", "width": "22%"},
          {"type": "select", "attr": "kind", "title": "Art", "options": [{"label": "Licht/Schalter", "value": "light"}, {"label": "Button/Trigger", "value": "button"}], "width": "10%"},
          {"type": "objectId", "attr": "targetId", "title": "Zieldatenpunkt", "width": "28%"},
          {"type": "text", "attr": "start", "title": "Von", "width": "7%"},
          {"type": "text", "attr": "end", "title": "Bis", "width": "7%"},
          {"type": "number", "attr": "minDurationMin", "title": "Min. min", "width": "6%"},
          {"type": "number", "attr": "maxDurationMin", "title": "Max. min", "width": "6%"},
          {"type": "number", "attr": "probability", "title": "%", "min": 0, "max": 100, "width": "4%"},
          {"type": "checkbox", "attr": "onlyDark", "title": "Dunkel", "width": "4%"}
        ]}
      }
    }
  }
}
